module(
    name = "yac",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_license", version = "1.0.0")

bazel_dep(name = "ftxui", version = "6.1.9")
bazel_dep(name = "catch2", version = "3.5.2")
bazel_dep(name = "tomlplusplus", version = "3.4.0")
bazel_dep(name = "boringssl", version = "0.20251110.0")
bazel_dep(name = "curl", version = "8.11.0.bcr.5")

aws_sdk_repository = use_repo_rule(
    "//bazel:aws_sdk_repo.bzl",
    "aws_sdk_repository",
)

aws_sdk_repository(
    name = "aws_sdk_bedrock",
    bundled_build = "//third_party:aws_sdk_bedrock.BUILD.bazel",
    compiler_select = "//bazel:aws_sdk_compiler_select.bzl",
)

git_override(
    module_name = "ftxui",
    remote = "https://github.com/ArthurSonzogni/FTXUI",
    commit = "84af6469fc54e2505802517ee62b4831897ab319",
)

single_version_override(
    module_name = "tomlplusplus",
    version = "3.4.0",
    patches = ["//third_party:tomlplusplus_visibility.patch"],
    patch_strip = 1,
)

single_version_override(
    module_name = "catch2",
    version = "3.5.2",
    patches = ["//third_party:catch2_rules_cc.patch"],
    patch_strip = 1,
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "openai_cpp",
    urls = [
        "https://github.com/olrea/openai-cpp/archive/9554a4d86d7650bb3b46db772dbacd5f3e054b8c.tar.gz",
    ],
    strip_prefix = "openai-cpp-9554a4d86d7650bb3b46db772dbacd5f3e054b8c",
    build_file = "//third_party:openai_cpp.BUILD.bazel",
)

http_archive(
    name = "keychain",
    urls = [
        "https://github.com/hrantzsch/keychain/archive/refs/tags/v1.3.1.tar.gz",
    ],
    strip_prefix = "keychain-1.3.1",
    build_file = "//third_party:keychain.BUILD.bazel",
)
